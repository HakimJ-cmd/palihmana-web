// ─────────────────────────────────────────────────────────────
// Palihmana.id — Prisma Schema v1.0
// ─────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ───────────────────────────── ENUMS ─────────────────────────────

enum Role {
  SUPER_ADMIN
  EDITOR
  CONTRIBUTOR
  COMMERCIAL
  MEMBER
}

enum Pilar {
  UTILITY
  UNDERSTAND
  OPINION
  DISCOVER
  PEOPLE
  FIELD_NOTES
}

enum ArticleStatus {
  DRAFT
  PRODUCTION
  FACT_CHECK
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum GeoScope {
  LOCAL
  REGIONAL
  NATIONAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FactCheckStatus {
  NOT_READY
  NEEDS_VERIFICATION
  READY_FOR_NEWSROOM
}

enum Comparability {
  SAFE_TO_COMPARE
  NEEDS_NOTE
  DO_NOT_COMPARE
}

enum UtilityCategory {
  EMERGENCY
  TRANSPORT
  DOCUMENT
  HEALTH
  UMKM
}

enum PriceType {
  FREE
  PAID
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  POSTPONED
  FINISHED
}

// ───────────────────────────── USERS ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  role          Role      @default(MEMBER)
  avatar        String?
  emailVerified DateTime? @map("email_verified")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  articles         Article[]           @relation("ArticleAuthor")
  factChecks       FactCheck[]         @relation("FactCheckVerifier")
  corrections      Correction[]        @relation("CorrectionUpdater")
  bookmarks        Bookmark[]
  favoritePilars   FavoritePilar[]
  auditLogs        AuditLog[]
  resetTokens      PasswordResetToken[]
  eventsCreated    Event[]             @relation("EventCreator")
  utilitiesCreated Utility[]           @relation("UtilityCreator")

  @@index([role])
  @@map("users")
}

// ───────────────────────────── ARTICLES ─────────────────────────────

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  subtitle      String?
  bodyJson      Json          @map("body_json")
  bodyText      String?       @map("body_text")
  summaryPoints String[]      @map("summary_points")
  pilar         Pilar
  geoScope      GeoScope      @default(LOCAL) @map("geo_scope")
  status        ArticleStatus @default(DRAFT)
  authorId      String        @map("author_id")

  coverImage   String? @map("cover_image")
  coverAlt     String? @map("cover_alt")
  coverCredit  String? @map("cover_credit")
  readingMinutes Int?  @map("reading_minutes")

  isFeatured   Boolean @default(false) @map("is_featured")
  isMonitoring Boolean @default(false) @map("is_monitoring")
  isSponsored  Boolean @default(false) @map("is_sponsored")

  scheduledAt      DateTime? @map("scheduled_at")
  publishedAt      DateTime? @map("published_at")
  contentUpdatedAt DateTime? @map("content_updated_at")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  author      User         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  factChecks  FactCheck[]
  corrections Correction[]
  bookmarks   Bookmark[]
  tags        ArticleTag[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([pilar, status, publishedAt(sort: Desc)])
  @@index([geoScope])
  @@index([isFeatured, status])
  @@index([authorId])
  @@map("articles")
}

// ───────────────────────────── FACT CHECKS ─────────────────────────────

model FactCheck {
  id               String          @id @default(cuid())
  articleId        String          @map("article_id")
  claims           Json
  primarySources   Json            @map("primary_sources")
  secondarySources Json            @map("secondary_sources")
  unverifiedItems  String[]        @map("unverified_items")
  comparability    Comparability?
  riskLevel        RiskLevel       @default(LOW) @map("risk_level")
  status           FactCheckStatus @default(NEEDS_VERIFICATION)
  verificationDate DateTime?       @map("verification_date")
  checkedAt        DateTime        @default(now()) @map("checked_at")
  verifiedById     String?         @map("verified_by_id")

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("FactCheckVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([articleId, checkedAt(sort: Desc)])
  @@index([status])
  @@index([riskLevel])
  @@map("fact_checks")
}

// ───────────────────────────── CORRECTIONS ─────────────────────────────

model Correction {
  id          String   @id @default(cuid())
  articleId   String   @map("article_id")
  note        String
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("CorrectionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt(sort: Desc)])
  @@map("corrections")
}

// ───────────────────────────── UTILITIES ─────────────────────────────

model Utility {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  category      UtilityCategory
  description   String
  contactNumber String?         @map("contact_number")
  gmapsLink     String?         @map("gmaps_link")
  address       String?
  openingHours  String?         @map("opening_hours")
  guideJson     Json?           @map("guide_json")
  isActive      Boolean         @default(true) @map("is_active")
  sortOrder     Int             @default(0) @map("sort_order")
  lastVerifiedAt DateTime?      @map("last_verified_at")
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  createdBy User? @relation("UtilityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, isActive, sortOrder])
  @@index([isActive])
  @@map("utilities")
}

// ───────────────────────────── EVENTS ─────────────────────────────

model Event {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  description      String
  eventDate        DateTime    @map("event_date")
  eventEnd         DateTime?   @map("event_end")
  location         String
  gmapsLink        String?     @map("gmaps_link")
  organizer        String
  priceType        PriceType   @default(FREE) @map("price_type")
  priceNote        String?     @map("price_note")
  isVerified       Boolean     @default(false) @map("is_verified")
  verifiedAt       DateTime?   @map("verified_at")
  registrationLink String?     @map("registration_link")
  status           EventStatus @default(SCHEDULED)
  createdById      String?     @map("created_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  createdBy User? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventDate])
  @@index([priceType, eventDate])
  @@index([isVerified, eventDate])
  @@map("events")
}

// ───────────────────────────── BOOKMARKS ─────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

// ───────────────────────────── AUDIT LOGS ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipHash     String?  @map("ip_hash")
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([targetType, targetId])
  @@index([userId, timestamp(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ═════════════════ TABEL PENDUKUNG ═════════════════

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]

  @@index([name])
  @@map("tags")
}

model ArticleTag {
  articleId String @map("article_id")
  tagId     String @map("tag_id")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model FavoritePilar {
  userId    String   @map("user_id")
  pilar     Pilar
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, pilar])
  @@map("favorite_pilars")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SearchQuery {
  id          String   @id @default(cuid())
  query       String   @unique
  hits        Int      @default(1)
  lastResults Int      @default(0) @map("last_results")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([hits(sort: Desc)])
  @@map("search_queries")
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique @map("from_path")
  toPath    String   @map("to_path")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("redirects")
}

model Media {
  id         String   @id @default(cuid())
  url        String
  alt        String
  credit     String?
  license    String?
  width      Int?
  height     Int?
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("media")
}
